[!POWERSHELLSCRIPT - STA]
<#
This example shows how to get values from HTML Web Form
#>

# Get GUI file path
$filePathGUI = getGUIFilePath "UserInteraction.html"

# Show WEB GUI 
$doc = showHTMLForm $filePathGUI #returns HTML Document

#Declare variables
$name = ''
$ageGroup = ''
$gender = ''
$bMarried = $false
$resumePath = ''
$skills = @()

if($doc -ne $null){

	$theForm = $doc.forms[0]

	$name = $doc.getElementById("txtName").value
	$ageGroup = $doc.getElementById("ddlAgeGroup").value

	#read values from radio buttons
	foreach($ctrl in $theForm)
	{
		if($ctrl.name -eq "rbGender" -and $ctrl.checked)
		{
			$gender = $ctrl.value
			break
		}
	}

	$bMarried = $doc.getElementById("chkMarried").checked
	$resumePath = $doc.getElementById("flResume").value

	if($resumePath -eq $null)
	{
		$resumePath = "N/A"
	}

	#read multiselect list box values
	$ctrl = $doc.getElementById("lstSkills")

	foreach($o in $ctrl.options)
	{
		if ($o.selected)
		{
			$skills += $o.value
		}
	}
	

	"You have selected:`n"

	"Name: " +	$name + "`n"
	"Age Group: " +	$ageGroup + "`n"
	"Gender: " +	$gender + "`n"
	"Married?: " +	$bMarried + "`n"
	"Resume: " +	$resumePath + "`n"
	"Skills: `n"

	foreach($o in $skills)
	{
		$o
	}
}

$doc = $null

[!/POWERSHELLSCRIPT]
